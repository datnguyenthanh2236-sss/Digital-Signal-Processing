clc; clear; close;

// Tạo figure nền trắng
f = scf(0);
f.background = color("white");

a = gca();
a.isoview = "on";
a.axes_visible = ["off", "off", "off"];
a.data_bounds = [-2.7, -2.7; 2.8, 2.8];

r_in = 1/3;
r_out = 2;
theta = linspace(0, 2*%pi, 300);

x_out = r_out * cos(theta);
y_out = r_out * sin(theta);
x_in  = r_in  * cos(theta);
y_in  = r_in  * sin(theta);

c_blue_light = addcolor([0.84, 0.84, 1.0]);
xfpoly(x_out, y_out, c_blue_light);
e1 = gce();
e1.line_mode = "off";
xfpoly(x_in, y_in, color("white"));
e2 = gce();
e2.line_mode = "off";

//line
plot(x_out, y_out, "b--");
e3 = gce();
e3.children.thickness = 2;

plot(x_in, y_in, "b--");
e4 = gce();
e4.children.thickness = 2;

// Vẽ trục
xarrows([-2.5, 2.5], [0, 0], 1.0, color("black"));
xarrows([0, 0], [-2.5, 2.5], 1.0, color("black"));

//red pole
plot([1/3, 2], [0, 0], "rx");
e5 = gce();
e5.children.mark_size = 8;
e5.children.thickness = 2;

//label
xstring(2.55, -0.15, "Re(z)");
xstring(-0.35, 2.55, "Im(z)");

t = xstring(-1.3, 1.0, "ROC : 1/3 < |z| < 2");
gce().font_foreground = color("blue");
gce().font_size = 3;

xstring(0.4, -0.4, "1/3");
xstring(2.08, -0.35, "2");
